# ==============================================================================
# SOCKEYE ENVIRONMENT CONFIGURATION
# ==============================================================================
export ALLOC_ID="st-nina-1"
export PROJECT_NAME="moovision"
export REPO_NAME="mooVision"
export USER_SCRATCH="/scratch/${ALLOC_ID}/${PROJECT_NAME}"
export UV_CACHE_DIR="${USER_SCRATCH}/.uv_cache"
export SKIP=10  # Downscaling Parameters

# ==============================================================================
# SOCKEYE PATH CONFIGURATION
# ==============================================================================
export ROOT_DIR=${USER_SCRATCH}
export LOCAL_DIR=/scratch/${ALLOC_ID}/${REPO_NAME}/

# ==============================================================================
# SOCKEYE YOLO_MODEL CONFIGURATION
# ==============================================================================
export WEIGHTS_DIR="./weights"
export YOLO_MODEL="yolo26m.pt"

# Bypass network timeout delays
export YOLO_OFFLINE=True
export HF_HUB_DISABLE_SYMLINKS_WARNING=1


# ─── PATH ARRAYS FOR THE 8 SPLITS ─────────────────────────────────────────────
# Array of (relative) paths pointing to your training CSVs inside ROOT_DIR
export YOLO_TRAIN_PATHS=(
    "data/processed/pipeline_demo/train.csv"
    "data/processed/random/train.csv"
    "data/processed/day_based/train.csv"
    "data/processed/pen_based/pen_2/train.csv"
    "data/processed/pen_based/pen_3/train.csv"
    "data/processed/pen_based/pen_5/train.csv"
    "data/processed/period_based/POSTWEAN/train.csv"
    "data/processed/period_based/PREWEAN/train.csv"
    "data/processed/period_based/WEAN/train.csv"
)

# Array of (relative) paths pointing to your validation CSVs inside ROOT_DIR
export YOLO_VAL_PATHS=(
    "data/processed/pipeline_demo/val.csv"
    "data/processed/random/val.csv"
    "data/processed/day_based/val.csv"
    "data/processed/pen_based/pen_2/val.csv"
    "data/processed/pen_based/pen_3/val.csv"
    "data/processed/pen_based/pen_5/val.csv"
    "data/processed/period_based/POSTWEAN/val.csv"
    "data/processed/period_based/PREWEAN/val.csv"
    "data/processed/period_based/WEAN/val.csv"
)

# Array of corresponding output (relative) directories on high-speed scratch space inside ROOT_DIR
export YOLO_OUTPUT_DIRS=(
    "data/training/pipeline_demo/yolo"
    "data/training/random/yolo/"
    "data/training/day_based/yolo/"
    "data/training/pen_based/pen_2/yolo/"
    "data/training/pen_based/pen_3/yolo/"
    "data/training/pen_based/pen_5/yolo/"
    "data/training/period_based/POSTWEAN/yolo/"
    "data/training/period_based/PREWEAN/yolo/"
    "data/training/period_based/WEAN/yolo/"
)

# Array of tar files containing 8 different data splits
export YOLO_TAR_FILES=(
    "${USER_SCRATCH}/data/training/pipeline_demo/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/random/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/day_based/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/pen_based/pen_2/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/pen_based/pen_3/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/pen_based/pen_5/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/period_based/POSTWEAN/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/period_based/PREWEAN/yolo/dataset.tar"
    "${USER_SCRATCH}/data/training/period_based/WEAN/yolo/dataset.tar"
)

export YOLO_SCRATCH_OUTPUT="${USER_SCRATCH}/data/yolo_training_runs"