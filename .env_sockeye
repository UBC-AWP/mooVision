# ==============================================================================
# SOCKEYE ENVIRONMENT CONFIGURATION
# ==============================================================================
export SOCKEYE_USER="your_cwl_username"
export ALLOC_ID="st-nina-1"
export PROJECT_NAME="moovision"
export REPO_NAME="mooVision"
export USER_SCRATCH="/scratch/${ALLOC_ID}/${PROJECT_NAME}"
export UV_CACHE_DIR="${USER_SCRATCH}/.uv_cache"
export SKIP=10  # Downscaling Parameters

# ==============================================================================
# SOCKEYE PATH CONFIGURATION
# ==============================================================================
ROOT_DIR=${USER_SCRATCH}
LOCAL_DIR=/scratch/${ALLOC_ID}/${REPO_NAME}/


# ─── PATH ARRAYS FOR THE 8 SPLITS ─────────────────────────────────────────────
# Array of paths pointing to your training CSVs
export PREPROCESS_YOLO_INPUT_PATHS=(
    "${LOCAL_DIR}/data/processed/random/train.csv"
    "${LOCAL_DIR}/data/processed/day_based/train.csv"
    "${LOCAL_DIR}/data/processed/pen_based/pen_2/train.csv"
    "${LOCAL_DIR}/data/processed/pen_based/pen_3/train.csv"
    "${LOCAL_DIR}/data/processed/pen_based/pen_5/train.csv"
    "${LOCAL_DIR}/data/processed/period_based/POSTWEAN/train.csv"
    "${LOCAL_DIR}/data/processed/period_based/PREWEAN/train.csv"
    "${LOCAL_DIR}/data/processed/period_based/WEAN/train.csv"
)

# Array of corresponding output directories on high-speed scratch space
export PREPROCESS_YOLO_OUTPUT_DIRS=(
    "${USER_SCRATCH}/training/random/yolo/"
    "${USER_SCRATCH}/training/day_based/yolo/"
    "${USER_SCRATCH}/training/pen_based/pen_2/yolo/"
    "${USER_SCRATCH}/training/pen_based/pen_3/yolo/"
    "${USER_SCRATCH}/training/pen_based/pen_5/yolo/"
    "${USER_SCRATCH}/training/period_based/POSTWEAN/yolo/"
    "${USER_SCRATCH}/training/period_based/PREWEAN/yolo/"
    "${USER_SCRATCH}/training/period_based/WEAN/yolo/"
)

# ─── ADD YOUR 8 TRAINING YAML PATHS HERE ──────────────────────────────────────
export YOLO_YAML_CONFIGS=(
    "${USER_SCRATCH}/training/random/yolo/dataset.yaml"
    "${USER_SCRATCH}/training/day_based/yolo/dataset.yaml"
    "${USER_SCRATCH}/training/pen_based/pen_2/yolo/dataset.yaml"
    "${USER_SCRATCH}/pen_based/pen_3/yolo/dataset.yaml"
    "${USER_SCRATCH}/training/pen_based/pen_5/yolo/dataset.yaml"
    "${USER_SCRATCH}/training/period_based/POSTWEAN/yolo/dataset.yaml"
    "${USER_SCRATCH}/training/period_based/PREWEAN/yolo/dataset.yaml"
    "${USER_SCRATCH}/training/period_based/WEAN/yolo/dataset.yaml"
)

export YOLO_SCRATCH_OUTPUT="${USER_SCRATCH}/yolo_training_runs"